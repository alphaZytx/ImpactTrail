RISKPULSE_ENV=development
RISKPULSE_DATABASE_URL=sqlite:///data/runtime/impacttrail.db
RISKPULSE_MODEL_BACKEND=auto
RISKPULSE_EVENT_BACKEND=rules
RISKPULSE_ALLOW_MODEL_DOWNLOADS=false
RISKPULSE_LOG_LEVEL=INFO
RISKPULSE_EVENT_CONFIDENCE_THRESHOLD=0.65
RISKPULSE_IMPACT_CONFIDENCE_THRESHOLD=0.60
RISKPULSE_STRESS_TRIGGER_THRESHOLD=7.0
RISKPULSE_GDELT_ENABLED=false
RISKPULSE_BLUESKY_ENABLED=false
RISKPULSE_POLL_INTERVAL_SECONDS=300
RISKPULSE_MAX_TEXT_LENGTH=8000

# Presentation metadata used by scripts/create_presentation.py.
RISKPULSE_CANDIDATE_NAME=Alok Chandra
RISKPULSE_COLLEGE=REPLACE_WITH_COLLEGE_NAME
