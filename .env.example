IMPACTTRAIL_ENV=development
IMPACTTRAIL_DATABASE_URL=sqlite:///data/runtime/impacttrail.db
IMPACTTRAIL_MODEL_BACKEND=auto
IMPACTTRAIL_EVENT_BACKEND=rules
IMPACTTRAIL_ALLOW_MODEL_DOWNLOADS=false
IMPACTTRAIL_LOG_LEVEL=INFO
IMPACTTRAIL_EVENT_CONFIDENCE_THRESHOLD=0.65
IMPACTTRAIL_IMPACT_CONFIDENCE_THRESHOLD=0.60
IMPACTTRAIL_STRESS_TRIGGER_THRESHOLD=7.0
IMPACTTRAIL_GDELT_ENABLED=false
IMPACTTRAIL_BLUESKY_ENABLED=false
IMPACTTRAIL_POLL_INTERVAL_SECONDS=300
IMPACTTRAIL_MAX_TEXT_LENGTH=8000

# Presentation metadata used by scripts/create_presentation.py.
IMPACTTRAIL_CANDIDATE_NAME=Alok Chandra
IMPACTTRAIL_COLLEGE=REPLACE_WITH_COLLEGE_NAME
